Screen { background: #171d1a; color: #ded9c9; }
Footer { background: #252e28; }
Button { background: #29372e; border: tall #425244; color: #ded9c9; }
Button:hover { background: #34483a; }
Button.-primary { background: #b58d58; color: #171d1a; border: tall #d4aa73; text-style: bold; }
Input, SelectCurrent { background: #222c25; border: tall #435448; }
Input:focus, Select:focus > SelectCurrent { border: tall #d4aa73; }
.muted { color: #98a396; height: auto; margin-bottom: 1; }
#library { max-width: 110; width: 100%; align-horizontal: center; margin: 1 4; }
#wordmark { color: #e3b875; text-style: bold; height: 3; content-align: left middle; }
#library-bar { height: 3; margin-top: 1; }
#shelf-label { width: 1fr; text-style: bold; color: #a6bca4; content-align: left middle; }
#library-bar Button { width: 22; }
#filter { margin: 1 0; }
#library-stats { height: 1; }
#shelf { height: 1fr; }
.puzzle-card { width: 100%; height: 5; margin-bottom: 1; content-align: left middle; padding: 0 2; }
#empty-shelf { padding: 2; height: auto; color: #d4aa73; }
#starter-software, #starter-rome { width: 45; margin: 0 2 1 2; }
#library-note { height: auto; margin-top: 1; }
#new-form { width: 76; max-width: 95%; height: 1fr; margin: 1 4; padding: 1 2; }
.eyebrow { color: #a6bca4; text-style: bold; height: 2; }
.page-title { text-style: bold; color: #e3b875; height: 2; }
#new-form Label { margin-top: 1; color: #a6bca4; }
#new-form Select, #new-form Input { margin-bottom: 1; }
#new-form Button { width: 100%; margin-top: 1; }
#loading { height: 3; }
#generation-status { height: auto; color: #e3b875; margin-top: 1; }
#play-header { height: 3; background: #222c25; padding: 0 2; }
#play-brand { width: 16; color: #e3b875; text-style: bold; content-align: left middle; }
#play-topic { width: 1fr; content-align: left middle; color: #a6bca4; }
#clock { width: 12; text-align: right; content-align: right middle; color: #e3b875; }
#active-clue { height: 4; padding: 1 2; background: #354738; color: #f1e3c8; text-style: bold; }
#play-body { height: 1fr; padding: 1 2; }
#grid-scroll { width: 2fr; height: 1fr; margin-right: 2; align-horizontal: center; }
#grid { padding: 0; margin: 0; }
#grid:focus { border: none; }
#clues { width: 1fr; min-width: 28; height: 1fr; padding: 0 1; }
.clue-heading { color: #d4aa73; text-style: bold; height: 2; padding-top: 1; }
.clue { height: auto; min-height: 2; padding: 0 1 1 1; }
.clue.filled { color: #839484; }
.clue.selected { background: #354738; color: #f1e3c8; text-style: bold; }
#play-status { height: 1; padding: 0 2; color: #d4aa73; }
#key-hint { height: 1; padding: 0 2; color: #98a396; }
.narrow #play-body { layout: vertical; }
.narrow #grid-scroll { width: 100%; height: 3fr; margin-right: 0; }
.narrow #clues { width: 100%; height: 1fr; min-height: 3; margin-top: 1; }
MessageDialog { align: center middle; background: #101612 85%; }
#dialog { width: 76; max-width: 95%; height: auto; max-height: 95%; overflow-y: auto; padding: 1 3; background: #26342a; border: round #b58d58; }
#dialog > Static { height: auto; margin-bottom: 1; }
.dialog-title { color: #e3b875; text-style: bold; }
.dialog-actions { height: 3; align-horizontal: right; }
.dialog-actions Button { margin-left: 1; min-width: 18; }
